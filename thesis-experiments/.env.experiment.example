# Copy to .env.experiment and fill in. .env.experiment is gitignored.
# Connection string for the EXPERIMENT database only (never production).
DATABASE_URL=
# Must equal the host part of DATABASE_URL, or every DB script refuses to run.
EXPERIMENT_DB_HOST=
# Comma-separated production hosts. Any match aborts.
PROD_DB_HOST_DENYLIST=
# OpenRouter key for model calls (Phase 4+).
OPENROUTER_API_KEY=
